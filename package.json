{
  "name": "智慧办公空间管理系统",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001 --strictPort",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:unit": "node --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test:capacity": "node --env-file-if-exists=.env scripts/perf/capacity.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/db/migrate.ts",
    "db:status": "node --env-file-if-exists=.env scripts/db/status.ts",
    "db:verify": "node --env-file-if-exists=.env scripts/db/verify.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/db/seed.ts",
    "db:seed:hq3d": "node --env-file-if-exists=.env scripts/db/seed-hq3d.ts",
    "db:apply:hq3d-confirmation": "node --env-file-if-exists=.env scripts/db/apply-hq3d-confirmation.ts",
    "fonts:fetch": "node scripts/fetch-fonts.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/db/native-backup.ts",
    "db:restore": "node --env-file-if-exists=.env scripts/db/native-restore.ts",
    "db:drill": "node --env-file-if-exists=.env scripts/db/native-drill.ts",
    "auth:bind": "node --env-file-if-exists=.env scripts/auth/bind-identity.ts",
    "auth:bootstrap": "node --env-file-if-exists=.env scripts/auth/bootstrap-admin.ts",
    "preview": "vite preview --port 3001 --strictPort"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.562.0",
    "mysql2": "^3.24.6",
    "openid-client": "^6.9.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tesseract.js": "^7.0.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "undici": "^8.12.4",
    "vite": "^6.2.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
